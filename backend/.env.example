# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit it.

APP_NAME=DocuMind AI
ENVIRONMENT=development

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=documind_user
MYSQL_PASSWORD=change_me
MYSQL_DB=documind

# ---------- Authentication ----------
# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- File uploads ----------
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10

# ---------- Document processing (Module 3) ----------
MAX_PAGES_PER_DOCUMENT=500
# eng+tel after installing Tesseract's Telugu language data
OCR_LANGUAGES=eng
# Only needed if tesseract.exe is not in C:\Program Files\Tesseract-OCR\ or on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------- Chunking and embeddings (Module 4) ----------
EMBEDDING_MODEL=multilingual-e5-base
CHUNK_STRATEGY=recursive
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
PRELOAD_MODELS=true

# ---------- Retrieval (Modules 4-5) ----------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=5
RELEVANCE_THRESHOLD=0.05

# ---------- Gemini LLM (Modules 5-7) ----------
# Free key: https://aistudio.google.com/apikey  - keep it ONLY here, never in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DESCRIBE_FIGURES=true

# ---------- Answer verification (Module 8) ----------
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# ---------- CORS ----------
# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
